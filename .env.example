# Copy this file to .env.local for local development, and add the same
# variables in Vercel → Project → Settings → Environment Variables.
#
# Leave the two Supabase values empty to run in demo mode (no backend,
# everything stays in your browser) so you can try the whole game locally.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# The "anon" key or the newer "publishable" key. Never put the service_role / secret key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only emails on this domain can sign in. Must match allowed_email_domain() in supabase/schema.sql.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=lamatic.ai

# Shown on the landing page.
NEXT_PUBLIC_EVENT_DATE_LABEL=Tuesday · 24 November
